# Copy to `.env` for local dev, and set the same vars in the Vercel project settings.
# All are PUBLIC_ (inlined into the client bundle at build time) — none are secrets.

# Google Analytics 4 Measurement ID. When unset, analytics is disabled (dev/preview safe).
PUBLIC_GA_ID=

# Web3Forms access key for the contact form. Get one free at https://web3forms.com
# (tied to the destination email). When unset, the form shows a configuration notice.
PUBLIC_WEB3FORMS_KEY=

# MailerLite embedded-form / account IDs for the newsletter signup.
# From MailerLite → Forms → Embedded form → "Use the universal script".
PUBLIC_MAILERLITE_ACCOUNT=
PUBLIC_MAILERLITE_FORM_ID=
