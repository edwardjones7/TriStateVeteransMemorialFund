---
import { Image } from 'astro:assets';
import { primaryNav, secondaryNav, site } from '@/config/site';
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import logo from '@/assets/logo.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header
  data-site-header
  class="sticky top-0 z-50 border-b-2 border-red bg-navy-deep text-bone transition-shadow duration-200 [&[data-scrolled]]:shadow-[0_14px_30px_-22px_rgba(0,0,0,0.9)]"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-2.5 sm:px-8 lg:px-12"
  >
    <a
      href="/"
      class="flex shrink-0 items-center"
      aria-label={`${site.name} — home`}
    >
      <Image
        src={logo}
        alt={site.name}
        class="h-12 w-auto sm:h-14"
        loading="eager"
      />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-x-4 lg:flex xl:gap-x-6">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'link-underline whitespace-nowrap py-1 font-stencil text-[0.95rem] font-bold uppercase tracking-[0.06em]',
              isActive(item.href) ? 'text-white' : 'text-bone/80',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={site.phoneHref}
        class="link-underline hidden items-center gap-2 text-sm font-medium text-bone/70 xl:inline-flex"
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        {site.phone}
      </a>
      <Button href="/donate" class="hidden sm:inline-flex">Donate</Button>
      <button
        type="button"
        data-menu-open
        class="inline-flex size-11 items-center justify-center text-bone lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" class="size-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<!-- Full-screen mobile menu -->
<div
  id="mobile-menu"
  data-mobile-menu
  hidden
  class="fixed inset-0 z-[70] flex flex-col bg-navy-deep text-bone lg:hidden"
>
  <div
    class="flex items-center justify-between border-b border-bone/15 px-6 py-3"
  >
    <span
      class="font-stencil text-xs font-bold uppercase tracking-[0.22em] text-bone/60"
      >Menu</span
    >
    <button
      type="button"
      data-menu-close
      class="inline-flex size-11 items-center justify-center text-bone"
      aria-label="Close menu"
    >
      <Icon name="lucide:x" class="size-6" aria-hidden="true" />
    </button>
  </div>
  <nav
    aria-label="Mobile"
    class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 py-8"
  >
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'border-b border-bone/12 py-3 font-display text-3xl uppercase',
            isActive(item.href) ? 'text-red-light' : 'text-bone',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      {
        secondaryNav.map((item) => (
          <a
            href={item.href}
            class="py-1 font-stencil text-sm font-bold uppercase tracking-[0.08em] text-bone/65"
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="mt-auto pt-8">
      <Button href="/donate" size="lg" class="w-full">Donate</Button>
      <a
        href={site.phoneHref}
        class="mt-4 flex items-center justify-center gap-2 text-sm font-medium text-bone/70"
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        {site.phone}
      </a>
    </div>
  </nav>
</div>
