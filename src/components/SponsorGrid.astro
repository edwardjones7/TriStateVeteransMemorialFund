---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { sponsorLogo } from '@/lib/sponsorLogos';
/**
 * SponsorGrid — the sponsor wall, a static uniform wall of cards. Every
 * sponsor gets the same-size card: logo in a fixed-height box, name
 * caption beneath. Cards link out when the sponsor has a url. `size`
 * picks the compact homepage density or the large /sponsors-page
 * treatment; both lay out via .sponsor-wall in global.css, which centers
 * a final short row rather than leaving a gap.
 * A sponsor with no logo file gets a set typographic mark instead —
 * `wordmark` in sponsors.json breaks it across lines so it stacks inside
 * the logo box rather than running past the card.
 */
interface Props {
  sponsors: CollectionEntry<'sponsors'>[];
  size?: 'compact' | 'large';
}
const { sponsors, size = 'compact' } = Astro.props;
const compact = size === 'compact';
---

<ul class:list={['sponsor-wall', compact && 'sponsor-wall--compact']}>
  {
    sponsors.map((s) => {
      const logo = sponsorLogo(s.id);
      const Tag = s.data.url ? 'a' : 'div';
      return (
        <li class="min-w-0">
          <Tag
            href={s.data.url}
            target={s.data.url ? '_blank' : undefined}
            rel={s.data.url ? 'noopener noreferrer' : undefined}
            class:list={[
              'flex h-full flex-col items-center justify-center gap-3 border border-line bg-white text-center',
              compact ? 'p-4' : 'p-6 sm:p-8',
              s.data.url &&
                'transition-[transform,border-color] duration-200 ease-out-soft hover:-translate-y-1 hover:border-red/45',
            ]}
          >
            <span
              class:list={[
                'flex w-full items-center justify-center',
                compact ? 'h-14 sm:h-16' : 'h-20 sm:h-24',
              ]}
            >
              {logo ? (
                <Image
                  src={logo}
                  alt=""
                  widths={[200, 400]}
                  sizes={
                    compact
                      ? '(min-width: 1280px) 150px, (min-width: 640px) 30vw, 45vw'
                      : '(min-width: 1024px) 240px, (min-width: 640px) 30vw, 45vw'
                  }
                  class="max-h-full w-auto max-w-full object-contain"
                />
              ) : (
                <span
                  class:list={[
                    'font-display uppercase leading-[1.05] text-ink',
                    compact ? 'text-base sm:text-lg' : 'text-xl sm:text-2xl',
                  ]}
                >
                  {(s.data.wordmark ?? [s.data.name]).map((line) => (
                    <span class="block">{line}</span>
                  ))}
                </span>
              )}
            </span>
            <span
              class:list={[
                'font-stencil font-bold uppercase text-ink-soft',
                compact
                  ? 'text-[0.65rem] tracking-[0.08em]'
                  : 'text-xs tracking-[0.1em]',
              ]}
            >
              {s.data.name}
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>
