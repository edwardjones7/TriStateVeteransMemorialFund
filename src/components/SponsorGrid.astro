---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
/**
 * SponsorGrid — the sponsor wall, rendered as a two-row marquee.
 * Each row scrolls in the opposite direction and loops seamlessly
 * (the logo set is output twice; the second copy is aria-hidden).
 * Pauses on hover/focus; collapses to a static grid under
 * prefers-reduced-motion (see global.css). Logo files live in
 * src/assets/sponsors/<id>.png.
 */
interface Props {
  sponsors: CollectionEntry<'sponsors'>[];
}
const { sponsors } = Astro.props;

const logos = import.meta.glob<ImageMetadata>('../assets/sponsors/*.png', {
  eager: true,
  import: 'default',
});
const logoFor = (id: string) => logos[`../assets/sponsors/${id}.png`];

const mid = Math.ceil(sponsors.length / 2);
const rows = [sponsors.slice(0, mid), sponsors.slice(mid)];
---

<div class="relative left-1/2 w-screen -translate-x-1/2 space-y-3">
  {
    rows.map((row, r) => (
      <div class="marquee">
        <div
          class:list={['marquee-track', r === 1 && 'marquee-track--reverse']}
        >
          {
            [false, true].map((isClone) =>
              row.map((s) => {
                const logo = logoFor(s.id);
                return (
                  <a
                    href={s.data.url ?? '#'}
                    target={s.data.url ? '_blank' : undefined}
                    rel={s.data.url ? 'noopener noreferrer' : undefined}
                    aria-label={isClone ? undefined : `${s.data.name} — visit website`}
                    aria-hidden={isClone ? 'true' : undefined}
                    tabindex={isClone ? -1 : undefined}
                    data-marquee-clone={isClone ? '' : undefined}
                    class="group mr-3 inline-flex h-24 shrink-0 items-center justify-center border border-line bg-white px-8 transition-colors duration-200 hover:bg-bone"
                  >
                    {logo ? (
                      <Image
                        src={logo}
                        alt={isClone ? '' : s.data.name}
                        widths={[200, 400]}
                        sizes="(min-width: 640px) 240px, 200px"
                        class="h-14 w-auto object-contain transition-transform duration-200 group-hover:scale-105 sm:h-16"
                      />
                    ) : (
                      <span class="whitespace-nowrap font-display text-lg text-ink">
                        {s.data.name}
                      </span>
                    )}
                  </a>
                );
              }),
            )
          }
        </div>
      </div>
    ))
  }
</div>
