---
import { site, primaryNav, secondaryNav } from '@/config/site';
/**
 * SEO — meta tags, Open Graph, Twitter card, and JSON-LD.
 * Organization + breadcrumb structured data are emitted automatically;
 * pages may pass extra structured data (e.g. Event) via `jsonLd`.
 */
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Override the final breadcrumb crumb's label (e.g. an event's name). */
  breadcrumbLabel?: string;
}
const {
  title,
  description = site.description,
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbLabel,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle =
  title === site.name ? title : `${title} — ${site.name}`;

/*
 * BreadcrumbList — derived from the URL path so every interior page gets a
 * trail without per-page wiring. Segment labels come from the nav config
 * where possible; the leaf can be overridden via `breadcrumbLabel`.
 */
const navLabels = new Map(
  [...primaryNav, ...secondaryNav].map((n) => [n.href, n.label]),
);
const titleCase = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const segments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumbLd: Record<string, unknown> | null = null;
if (segments.length > 0) {
  const crumbs = [{ name: 'Home', url: `${site.url}/` }];
  let acc = '';
  segments.forEach((seg, i) => {
    acc += `/${seg}`;
    const isLast = i === segments.length - 1;
    const name =
      isLast && breadcrumbLabel
        ? breadcrumbLabel
        : (navLabels.get(acc) ?? titleCase(seg));
    crumbs.push({ name, url: new URL(`${acc}/`, site.url).href });
  });
  breadcrumbLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: c.name,
      item: c.url,
    })),
  };
}

const orgLd = {
  '@context': 'https://schema.org',
  '@type': ['NGO', 'LocalBusiness'],
  name: site.name,
  url: site.url,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: 'South Jersey, Southeastern Pennsylvania, Northern Delaware',
  sameAs: [site.social.facebook, site.social.youtube],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0c1730" />

<script
  type="application/ld+json"
  set:html={JSON.stringify(orgLd)}
/>
{
  breadcrumbLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  )
}
{
  jsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}
