---
import Button from './Button.astro';
import PoppyMark from './PoppyMark.astro';
import Reveal from './Reveal.astro';
import { site } from '@/config/site';
/** CallToAction — closing band, reused near the foot of most pages. */
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Don't they deserve this?",
  body = 'Join our growing community of Americans who care for our heroes — and help them find the peace they have earned.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-poppy text-paper">
  <PoppyMark
    class="pointer-events-none absolute -bottom-16 -left-10 w-64 text-paper/10"
  />
  <div
    class="mx-auto flex max-w-4xl flex-col items-center px-6 py-20 text-center sm:px-8 sm:py-24"
  >
    <Reveal>
      <h2 class="font-display text-3xl sm:text-4xl">{heading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-paper/85">{body}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button
          href="/donate"
          class="bg-paper text-poppy hover:bg-paper-deep hover:text-poppy-deep"
          size="lg">Make a donation</Button
        >
        <Button href="/contact" variant="on-dark" size="lg">Get in touch</Button>
      </div>
      <p class="mt-6 font-typewriter text-xs uppercase tracking-[0.16em] text-paper/70">
        Or call us &middot; {site.phone}
      </p>
    </Reveal>
  </div>
</section>
