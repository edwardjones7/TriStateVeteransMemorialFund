---
/**
 * DogTag — a stamped service tag that pins the essentials of a ceremony
 * (what, when, admission) to its spotlight card. Lines are embossed the way
 * a real tag is, one fact per line. Purely decorative: the same facts sit in
 * the card's text, so the whole tag is hidden from assistive tech.
 */
interface Props {
  /** Up to four short lines, top to bottom. Rendered in caps. */
  lines: string[];
  class?: string;
}
const { lines, class: cls = '' } = Astro.props;
---

<div class:list={['tag-wrap', cls]} aria-hidden="true">
  {/* Bead chain running off the top edge */}
  <span class="chain"></span>
  <div class="tag">
    <span class="hole"></span>
    <div class="min-w-0 pl-7">
      {lines.slice(0, 4).map((line) => (
        <p class="emboss truncate font-stencil text-[0.68rem] uppercase leading-[1.45] tracking-[0.08em]">
          {line}
        </p>
      ))}
    </div>
  </div>
</div>

<style>
  .tag-wrap {
    position: relative;
    width: 14.5rem;
    rotate: 4deg;
    transition: rotate 400ms var(--ease-out-soft);
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.45));
  }
  :global(.group:hover) .tag-wrap {
    rotate: 1deg;
  }
  .tag {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 5.5rem;
    padding: 0.75rem 1rem 0.75rem 0.5rem;
    border-radius: 1.4rem / 1.9rem;
    /* Brushed steel */
    background:
      repeating-linear-gradient(
        100deg,
        rgb(255 255 255 / 0.05) 0 1px,
        transparent 1px 3px
      ),
      linear-gradient(
        135deg,
        #eef0f3 0%,
        #b9c0cb 32%,
        #e3e6ea 52%,
        #9aa3b0 78%,
        #cfd4db 100%
      );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      inset 0 -2px 3px rgb(0 0 0 / 0.25),
      0 0 0 1px rgb(0 0 0 / 0.25);
  }
  /* Rolled rim, as on a real tag */
  .tag::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 0 0 1px rgb(255 255 255 / 0.5);
    pointer-events: none;
  }
  .hole {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 0.8rem;
    height: 0.8rem;
    translate: 0 -50%;
    border-radius: 9999px;
    background: var(--color-navy-deep);
    box-shadow:
      inset 0 2px 2px rgb(0 0 0 / 0.6),
      0 1px 0 rgb(255 255 255 / 0.7);
  }
  .chain {
    position: absolute;
    left: 1.25rem;
    bottom: 50%;
    width: 3px;
    height: 6rem;
    translate: -1px 0;
    rotate: -18deg;
    transform-origin: bottom center;
    background: radial-gradient(circle, #c7cdd5 1.3px, transparent 1.6px) 0 0 / 3px 5px repeat-y;
  }
  .emboss {
    color: #3a414c;
    text-shadow:
      0 1px 0 rgb(255 255 255 / 0.75),
      0 -1px 0 rgb(0 0 0 / 0.25);
  }
</style>
