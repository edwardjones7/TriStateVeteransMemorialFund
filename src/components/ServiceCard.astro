---
import { Icon } from 'astro-icon/components';
/** ServiceCard — a single program, linking to the Services page. */
interface Props {
  title: string;
  summary: string;
  icon: string;
  href: string;
}
const { title, summary, icon, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col border border-line bg-bone p-7 transition-[border-color,background-color,transform] duration-200 ease-out-soft hover:-translate-y-1 hover:border-red/45 hover:bg-bone-deep"
>
  <span
    class="inline-flex size-12 items-center justify-center rounded-full border border-line text-red transition-colors group-hover:border-red/50"
  >
    <Icon name={`lucide:${icon}`} class="size-6" aria-hidden="true" />
  </span>
  <h3 class="mt-5 font-display text-2xl">{title}</h3>
  <p class="mt-2.5 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">
    {summary}
  </p>
  <span
    class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-red"
  >
    Learn more
    <Icon
      name="lucide:arrow-right"
      class="size-4 transition-transform duration-200 group-hover:translate-x-1"
      aria-hidden="true"
    />
  </span>
</a>
