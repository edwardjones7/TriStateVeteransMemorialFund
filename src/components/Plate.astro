---
import StarMark from './StarMark.astro';
/**
 * Plate — a structured placeholder panel. Stands in wherever a
 * photograph belongs until real assets are supplied (PRD §15.5).
 * Styled as a framed service panel with a star and a stencil label.
 */
interface Props {
  ratio?: string;
  label?: string;
  tone?: 'bone' | 'navy' | 'navy-deep';
  /** fill: drop the aspect ratio and fill a positioned parent instead. */
  fill?: boolean;
  class?: string;
}
const {
  ratio = '4 / 3',
  label = 'Photograph',
  tone = 'navy',
  fill = false,
  class: cls = '',
} = Astro.props;

const tones = {
  bone: 'bg-bone-deep text-ink-soft',
  navy: 'bg-navy text-bone/80 texture-navy-deep',
  'navy-deep': 'bg-navy-deep text-bone/70 texture-navy-deep',
};
---

<div
  class:list={[
    'overflow-hidden',
    fill ? 'absolute inset-0 h-full w-full' : 'relative',
    tones[tone],
    cls,
  ]}
  style={fill ? undefined : `aspect-ratio:${ratio}`}
  data-plate
>
  {/* inner service frame */}
  <span
    class="pointer-events-none absolute inset-3 border border-current opacity-25"
    aria-hidden="true"></span>
  {/* corner ticks */}
  <span class="pointer-events-none absolute left-3 top-3 size-3 border-l-2 border-t-2 border-current opacity-50" aria-hidden="true"></span>
  <span class="pointer-events-none absolute right-3 top-3 size-3 border-r-2 border-t-2 border-current opacity-50" aria-hidden="true"></span>
  <span class="pointer-events-none absolute bottom-3 left-3 size-3 border-b-2 border-l-2 border-current opacity-50" aria-hidden="true"></span>
  <span class="pointer-events-none absolute bottom-3 right-3 size-3 border-b-2 border-r-2 border-current opacity-50" aria-hidden="true"></span>

  <div
    class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center"
  >
    <StarMark class="w-8 opacity-70" />
    <span
      class="font-stencil text-[0.7rem] uppercase tracking-[0.22em] opacity-80"
      >{label}</span
    >
  </div>
</div>
