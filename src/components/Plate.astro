---
import PoppyMark from './PoppyMark.astro';
/**
 * Plate — an archival photo-mount placeholder. Stands in wherever a
 * photograph belongs until real assets are supplied (PRD §15.5).
 * Styled to look intentional: a tinted mount with album corners.
 */
interface Props {
  ratio?: string;
  label?: string;
  tone?: 'paper' | 'field' | 'night';
  class?: string;
}
const {
  ratio = '4 / 3',
  label = 'Photograph',
  tone = 'paper',
  class: cls = '',
} = Astro.props;

const tones = {
  paper: 'bg-gradient-to-br from-paper-deep to-[#e2d4b4] text-field-soft',
  field: 'bg-gradient-to-br from-field to-[#283120] text-paper/75',
  night: 'bg-gradient-to-br from-night to-[#161811] text-paper/65',
};

const corners = [
  'left-2.5 top-2.5 [clip-path:polygon(0_0,100%_0,0_100%)]',
  'right-2.5 top-2.5 [clip-path:polygon(0_0,100%_0,100%_100%)]',
  'left-2.5 bottom-2.5 [clip-path:polygon(0_0,100%_100%,0_100%)]',
  'right-2.5 bottom-2.5 [clip-path:polygon(100%_0,100%_100%,0_100%)]',
];
---

<div
  class:list={['relative overflow-hidden', tones[tone], cls]}
  style={`aspect-ratio:${ratio}`}
  data-plate
>
  <span
    class="pointer-events-none absolute inset-3 border border-current opacity-20"
    aria-hidden="true"></span>
  {
    corners.map((c) => (
      <span
        class:list={['absolute h-5 w-5 bg-current opacity-35', c]}
        aria-hidden="true"
      />
    ))
  }
  <div
    class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center"
  >
    <PoppyMark class="w-9" />
    <span
      class="font-typewriter text-[0.7rem] uppercase tracking-[0.22em] opacity-75"
      >{label}</span
    >
  </div>
</div>
