---
import { primaryNav, secondaryNav, site } from '@/config/site';
import { Icon } from 'astro-icon/components';
import Emblem from './Emblem.astro';
import Button from './Button.astro';
import NewsletterSignup from './NewsletterSignup.astro';

const year = new Date().getFullYear();
const allLinks = [...primaryNav, ...secondaryNav, { label: 'Donate', href: '/donate' }];
---

<footer class="bg-navy-deep text-bone texture-navy-deep">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <NewsletterSignup class="border-b border-bone/15 py-14" />

    <div class="grid gap-12 border-b border-bone/15 py-16 md:grid-cols-12">
      <!-- Zone 1 — identity + contact -->
      <div class="md:col-span-5">
        <div class="flex items-start gap-5">
          <Emblem class="w-24 shrink-0 text-gold" />
          <div>
            <p class="font-display text-xl font-semibold">
              TriState Veterans Memorial Fund
            </p>
            <p class="mt-2 max-w-sm text-sm leading-relaxed text-bone/70">
              Honoring and supporting U.S. military veterans across South
              Jersey, Southeastern Pennsylvania, and Northern Delaware.
            </p>
          </div>
        </div>
        <address class="mt-7 space-y-1 text-sm not-italic leading-relaxed text-bone/75">
          <p>{site.address.full}</p>
          <p>Mailing: {site.mailing}</p>
          <p>
            <a href={site.phoneHref} class="link-underline">{site.phone}</a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="link-underline"
              >{site.email}</a
            >
          </p>
        </address>
        <div
          class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-bone/75"
        >
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-2"
          >
            <Icon name="lucide:facebook" class="size-4" aria-hidden="true" />
            Facebook
          </a>
          <a
            href={site.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-2"
          >
            <Icon name="lucide:youtube" class="size-4" aria-hidden="true" />
            YouTube
          </a>
          <span class="inline-flex items-center gap-2">
            <Icon name="lucide:radio" class="size-4" aria-hidden="true" />
            Hear us on {site.radio}
          </span>
        </div>
      </div>

      <!-- Zone 2 — sitemap -->
      <nav class="md:col-span-4 md:col-start-7" aria-label="Footer">
        <p
          class="font-stencil text-xs uppercase tracking-[0.2em] text-bone/50"
        >
          Explore
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm">
          {
            allLinks.map((item) => (
              <li>
                <a href={item.href} class="link-underline text-bone/85">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Zone 3 — call to action -->
      <div class="md:col-span-2 md:col-start-11">
        <p
          class="font-stencil text-xs uppercase tracking-[0.2em] text-bone/50"
        >
          Stand with us
        </p>
        <p class="mt-4 text-sm leading-relaxed text-bone/75">
          Every gift helps a veteran find peace.
        </p>
        <Button href="/donate" variant="on-dark" class="mt-4 w-full"
          >Donate</Button
        >
      </div>
    </div>

    <div
      class="flex flex-col gap-3 py-7 text-xs text-bone/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        {site.name} is a registered 501(c)(3) nonprofit. Donations are
        tax-deductible to the extent allowed by law.
      </p>
      <p class="flex items-center gap-3">
        <a href="/privacy" class="link-underline">Privacy Policy</a>
        <span aria-hidden="true">&middot;</span>
        <span>&copy; {year} {site.name}. All rights reserved.</span>
        <span aria-hidden="true">&middot;</span>
        <span>
          Powered by
          <a
            href="https://elenos.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline">Elenos</a
          >
        </span>
      </p>
    </div>
  </div>
</footer>
