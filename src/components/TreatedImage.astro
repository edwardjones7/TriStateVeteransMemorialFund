---
import { Image } from 'astro:assets';
import Plate from './Plate.astro';
/**
 * TreatedImage — renders a real photograph with the warm "develop"
 * treatment, or falls back to a Plate placeholder when no `src` is
 * given. `fill` drops the aspect ratio to fill a positioned parent.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: string;
  label?: string;
  tone?: 'bone' | 'navy' | 'navy-deep';
  fill?: boolean;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  class?: string;
}
const {
  src,
  alt = '',
  ratio = '4 / 3',
  label,
  tone = 'navy',
  fill = false,
  loading = 'lazy',
  sizes = '(min-width: 1024px) 600px, 100vw',
  class: cls = '',
} = Astro.props;

const widths = [480, 768, 1100, 1600];
---

{
  src ? (
    fill ? (
      <Image
        src={src}
        alt={alt}
        loading={loading}
        sizes={sizes}
        widths={widths}
        class:list={[
          'treated develop absolute inset-0 h-full w-full object-cover',
          cls,
        ]}
      />
    ) : (
      <div
        class:list={['relative overflow-hidden', cls]}
        style={`aspect-ratio:${ratio}`}
      >
        <Image
          src={src}
          alt={alt}
          loading={loading}
          sizes={sizes}
          widths={widths}
          class="treated develop h-full w-full object-cover"
        />
      </div>
    )
  ) : (
    <Plate
      ratio={ratio}
      label={label ?? 'Photograph'}
      tone={tone}
      fill={fill}
      class={cls}
    />
  )
}
