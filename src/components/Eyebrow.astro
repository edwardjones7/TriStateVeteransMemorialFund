---
import StarMark from './StarMark.astro';
/** Eyebrow — a stencil service label that sits above headings. */
interface Props {
  tone?: 'ink' | 'red' | 'bone';
  class?: string;
}
const { tone = 'red', class: cls = '' } = Astro.props;

const tones = {
  ink: 'text-ink-soft',
  red: 'text-red',
  bone: 'text-bone/75',
};
---

<p
  class:list={[
    'flex items-center gap-2 font-stencil text-[0.8125rem] font-bold uppercase tracking-[0.18em]',
    tones[tone],
    cls,
  ]}
>
  <StarMark class="w-3" aria-hidden="true" />
  <slot />
</p>
