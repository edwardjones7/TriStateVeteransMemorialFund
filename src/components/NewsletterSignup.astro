---
/**
 * Newsletter signup. Captures interested visitors so events (the 5K first)
 * can be promoted to them directly — important because registration itself
 * happens off-site on RunSignup.
 *
 * Uses MailerLite's official universal embed (no backend / no secret needed
 * on a static site). Set PUBLIC_MAILERLITE_ACCOUNT and PUBLIC_MAILERLITE_FORM_ID;
 * style the form itself in the MailerLite form builder. When unconfigured it
 * renders a graceful fallback so dev/preview builds stay clean.
 *
 * The GA4 `newsletter_signup` event is fired on submit by src/scripts/track.ts
 * (it watches forms inside `.ml-embedded`).
 */
interface Props {
  heading?: string;
  copy?: string;
  class?: string;
}
const {
  heading = 'Never miss the next event',
  copy = 'Get 5K registration reminders, ceremony dates, and ways to support our veterans — straight to your inbox.',
  class: cls = '',
} = Astro.props;

const account = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT ?? '';
const formId = import.meta.env.PUBLIC_MAILERLITE_FORM_ID ?? '';
const configured = Boolean(account && formId);
---

<section id="newsletter" class:list={['scroll-mt-24', cls]} aria-label="Newsletter signup">
  <p class="font-stencil text-xs uppercase tracking-[0.2em] text-bone/50">Stay in the loop</p>
  <h2 class="mt-3 font-display text-2xl text-bone sm:text-3xl">{heading}</h2>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-bone/75">{copy}</p>

  {
    configured ? (
      <div class="mt-6 max-w-xl">
        <div class="ml-embedded" data-form={formId} />
      </div>
    ) : (
      <p class="mt-6 max-w-xl text-sm text-bone/60">
        Signups open soon. In the meantime, follow us on{' '}
        <a
          href="https://www.facebook.com/profile.php?id=61553187641153"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline font-medium text-bone"
        >
          Facebook
        </a>{' '}
        for event news.
      </p>
    )
  }
</section>

{
  configured && (
    <script is:inline define:vars={{ account }}>
      (function () {
        if (window.__mlLoaded) return;
        window.__mlLoaded = true;
        (function (w, d, e, u, f, l, n) {
          w[f] =
            w[f] ||
            function () {
              (w[f].q = w[f].q || []).push(arguments);
            };
          (l = d.createElement(e)), (l.async = 1), (l.src = u);
          (n = d.getElementsByTagName(e)[0]), n.parentNode.insertBefore(l, n);
        })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
        window.ml('account', account);
      })();
    </script>
  )
}
