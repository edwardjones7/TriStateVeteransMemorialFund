---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import TreatedImage from './TreatedImage.astro';
import Button from './Button.astro';
import { formatDate, dateParts } from '@/lib/format';

/** EventCard — `featured` renders a large two-column card; otherwise a
 *  compact archive row with a date block and optional thumbnail. */
interface Props {
  event: CollectionEntry<'events'>;
  status: 'upcoming' | 'past';
  featured?: boolean;
  hideImage?: boolean;
  /** When set, the event title links to its detail page. */
  href?: string;
}
const { event, status, featured = false, hideImage = false, href } = Astro.props;
const d = event.data;
const parts = dateParts(d.date);
const place = d.address ? `${d.location}, ${d.address}` : d.location;
/* Portrait images (e.g. event flyers) are letterboxed instead of cropped —
 * cropping would cut off flyer text. */
const isPortrait = !!d.image && d.image.height > d.image.width;
---

{
  featured ? (
    <article class={`grid overflow-hidden border border-line bg-bone-deep ${hideImage ? '' : 'md:grid-cols-2'}`}>
      {!hideImage && (
        <div class={`relative ${isPortrait ? 'min-h-[24rem] md:min-h-0' : 'min-h-[16rem]'}`}>
          <TreatedImage
            src={d.image}
            alt={d.imageLabel ?? d.title}
            label={d.imageLabel ?? 'Event photograph'}
            fill
            imgClass={isPortrait ? 'object-contain!' : ''}
          />
        </div>
      )}
      <div class="flex flex-col justify-center p-8 lg:p-10">
        <p class="font-stencil text-xs uppercase tracking-[0.18em] text-red">
          {status === 'upcoming' ? 'Our next event' : 'From the archive'}
        </p>
        <h3 class="mt-3 font-display text-3xl">
          {href ? <a href={href} class="link-underline">{d.title}</a> : d.title}
        </h3>
        <ul class="mt-5 space-y-2 text-sm text-ink-soft">
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:calendar" class="mt-0.5 size-4 shrink-0 text-red" aria-hidden="true" />
            {formatDate(d.date)}
          </li>
          {d.startTime && (
            <li class="flex items-start gap-2.5">
              <Icon name="lucide:clock" class="mt-0.5 size-4 shrink-0 text-red" aria-hidden="true" />
              {d.startTime}
            </li>
          )}
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-red" aria-hidden="true" />
            {place}
          </li>
          {d.entryFee && (
            <li class="flex items-start gap-2.5">
              <Icon name="lucide:ticket" class="mt-0.5 size-4 shrink-0 text-red" aria-hidden="true" />
              {d.entryFee}
            </li>
          )}
        </ul>
        <p class="mt-4 text-[0.95rem] leading-relaxed">{event.body}</p>
        {d.registrationUrl && status === 'upcoming' && (
          <Button href={d.registrationUrl} external class="mt-6 self-start">
            Register on RunSignup
          </Button>
        )}
      </div>
    </article>
  ) : (
    <article class="flex gap-5 border-b border-line py-7 sm:gap-7">
      <div class="w-14 shrink-0 text-center">
        <span class="block font-stencil text-xs tracking-[0.15em] text-red">
          {parts.month}
        </span>
        <span class="block font-display text-3xl leading-none">{parts.day}</span>
        <span class="block font-stencil text-[0.7rem] text-ink-soft">
          {parts.year}
        </span>
      </div>
      {!hideImage && d.image && (
        <div class="hidden w-40 shrink-0 sm:block">
          <TreatedImage src={d.image} alt={d.imageLabel ?? d.title} ratio="4 / 3" />
        </div>
      )}
      <div class="min-w-0">
        <h3 class="font-display text-xl">
          {href ? <a href={href} class="link-underline">{d.title}</a> : d.title}
        </h3>
        <p class="mt-1 text-sm text-ink-soft">{place}</p>
        {d.startTime && <p class="text-sm text-ink-soft">{d.startTime}</p>}
        <p class="mt-2 text-[0.95rem] leading-relaxed">{event.body}</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          {d.entryFee && <span class="text-ink-soft">{d.entryFee}</span>}
          {d.hosts && <span class="text-ink-soft">{d.hosts}</span>}
          {d.registrationUrl && status === 'upcoming' && (
            <a
              href={d.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-semibold text-red"
            >
              Register &rarr;
            </a>
          )}
        </div>
      </div>
    </article>
  )
}
