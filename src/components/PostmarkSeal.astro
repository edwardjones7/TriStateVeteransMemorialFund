---
import { site } from '@/config/site';
/** PostmarkSeal — circular stamp motif. Text curves around the ring. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const ring =
  `★ EST. ${site.founded} · SEWELL, NEW JERSEY · 501(C)(3) NONPROFIT · HONOR THE SERVICE · `;
---

<svg
  viewBox="0 0 200 200"
  class:list={['select-none', cls]}
  role="img"
  aria-label={`${site.name}, established ${site.founded} in Sewell, New Jersey — a 501(c)(3) nonprofit`}
  fill="currentColor"
>
  <defs>
    <path
      id="seal-ring"
      d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"
    />
  </defs>
  <circle cx="100" cy="100" r="95" fill="none" stroke="currentColor" stroke-width="1.25" />
  <circle cx="100" cy="100" r="88" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.6" />
  <circle cx="100" cy="100" r="55" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.6" />
  <text font-size="9.4" letter-spacing="1.6" style="font-family:var(--font-body);font-weight:700">
    <textPath href="#seal-ring" startOffset="0">{ring}</textPath>
  </text>
  <text
    x="100" y="95"
    text-anchor="middle"
    style="font-family:var(--font-display);font-weight:600"
    font-size="30"
  >TSVMF</text>
  <text
    x="100" y="120"
    text-anchor="middle"
    style="font-family:var(--font-typewriter)"
    font-size="9"
    letter-spacing="3"
  >HONOR &middot; HEAL</text>
  <g opacity="0.85">
    <circle cx="100" cy="132" r="1.6" />
  </g>
</svg>
