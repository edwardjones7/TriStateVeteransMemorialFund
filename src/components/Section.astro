---
/**
 * Section — consistent page section wrapper.
 * tone sets the background; width controls the inner measure.
 */
interface Props {
  tone?: 'bone' | 'bone-deep' | 'navy-deep' | 'navy';
  width?: 'default' | 'wide' | 'narrow';
  class?: string;
  id?: string;
  as?: 'section' | 'div' | 'header' | 'footer';
}
const {
  tone = 'bone',
  width = 'default',
  class: cls = '',
  id,
  as = 'section',
} = Astro.props;

const toneClass = {
  bone: 'bg-bone text-ink',
  'bone-deep': 'bg-bone-deep text-ink',
  'navy-deep': 'bg-navy-deep text-bone texture-navy-deep',
  navy: 'bg-navy text-bone',
}[tone];

const widthClass = {
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
  narrow: 'max-w-3xl',
}[width];

const Tag = as;
---

<Tag id={id} class:list={[toneClass, 'relative', cls]}>
  <div class:list={[widthClass, 'mx-auto px-6 sm:px-8 lg:px-12']}>
    <slot />
  </div>
</Tag>
