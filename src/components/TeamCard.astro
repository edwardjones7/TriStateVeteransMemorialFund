---
import { Icon } from 'astro-icon/components';
import Plate from './Plate.astro';
/** TeamCard — a board / advisory member. Bio is passed via the slot. */
interface Props {
  name: string;
  role: string;
  isVeteran?: boolean;
  branch?: string;
}
const { name, role, isVeteran = false, branch } = Astro.props;
---

<article class="grid gap-6 sm:grid-cols-[10rem_1fr] sm:gap-7">
  <Plate ratio="1 / 1" label="Portrait" class="sm:w-40" />
  <div>
    <h3 class="font-display text-2xl">{name}</h3>
    <p
      class="mt-1 font-typewriter text-xs uppercase tracking-[0.16em] text-poppy"
    >
      {role}
    </p>
    {
      isVeteran && branch && (
        <p class="mt-2 inline-flex items-center gap-1.5 border border-field/30 bg-field/5 px-2.5 py-1 text-xs font-semibold text-field-soft">
          <Icon name="lucide:medal" class="size-3.5" aria-hidden="true" />
          Veteran &middot; {branch}
        </p>
      )
    }
    <div
      class="mt-3 space-y-3 text-[0.95rem] leading-relaxed text-ink-soft [&_p]:m-0"
    >
      <slot />
    </div>
  </div>
</article>
