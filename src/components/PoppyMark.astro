---
/** PoppyMark — the recurring remembrance-poppy motif. Decorative only. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  class:list={['select-none', cls]}
  aria-hidden="true"
  fill="currentColor"
>
  <g opacity="0.5">
    <ellipse cx="50" cy="31" rx="16" ry="21" transform="rotate(45 50 50)" />
    <ellipse cx="50" cy="31" rx="16" ry="21" transform="rotate(135 50 50)" />
  </g>
  <g opacity="0.92">
    <ellipse cx="50" cy="30" rx="19" ry="23" />
    <ellipse cx="50" cy="30" rx="19" ry="23" transform="rotate(90 50 50)" />
  </g>
  <circle cx="50" cy="50" r="7.5" />
  <g opacity="0.45">
    <circle cx="50" cy="41" r="1.6" />
    <circle cx="59" cy="50" r="1.6" />
    <circle cx="50" cy="59" r="1.6" />
    <circle cx="41" cy="50" r="1.6" />
  </g>
</svg>
