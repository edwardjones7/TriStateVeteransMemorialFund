---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import Button from '@/components/Button.astro';
import CallToAction from '@/components/CallToAction.astro';
import { Icon } from 'astro-icon/components';

import polo from '@/assets/shop/polo.png';
import hoodie from '@/assets/shop/hoodie.png';
import tshirt from '@/assets/shop/tshirt.png';
import cap from '@/assets/shop/cap.png';

/*
 * Merchandise is sold through the fund's third-party Spiritsale store.
 * Each card links out to the product; add new items to `products` as the
 * store grows (drop the render in src/assets/shop and import it here).
 */
const storeUrl = 'https://tristateveterans.spiritsale.com';

const products = [
  {
    name: "Men's Advantage Snag Protection Plus Polo",
    type: 'Polo',
    img: polo,
    url: 'https://tristateveterans.spiritsale.com/products/men-s-advantage-snag-protection-plus-polo-4bcf561a-49f2-4e50-8209-c5fc30326342',
  },
  {
    name: 'Adult PCH Pullover Hoodie',
    type: 'Hoodie',
    img: hoodie,
    url: 'https://tristateveterans.spiritsale.com/products/adult-pch-pullover-hoodie',
  },
  {
    name: 'Unisex CVC Crewneck T-Shirt',
    type: 'T-Shirt',
    img: tshirt,
    url: 'https://tristateveterans.spiritsale.com/products/unisex-cvc-crewneck-t-shirt-37b5087b-d26f-4850-8fee-3d9fb39d9530',
  },
  {
    name: 'Veil® Retro Trucker Cap',
    type: 'Cap',
    img: cap,
    url: 'https://tristateveterans.spiritsale.com/products/veil-retro-trucker-cap',
  },
];
---

<Base
  title="Shop"
  description="Shop official TriState Veterans Memorial Fund apparel — polos, hoodies, tees, and caps. Every purchase supports programs that benefit veterans."
>
  <PageHeader
    eyebrow="Shop"
    title="Wear your support."
    intro="Every purchase from our store supports programs that benefit veterans. Browse our gear below — checkout is handled securely through our Spiritsale store."
  />

  <Section class="py-20 sm:py-24">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        products.map((item, i) => (
          <Reveal delay={i * 70}>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col border border-line bg-bone transition-[border-color,box-shadow] hover:border-ink hover:shadow-sm"
            >
              <div class="relative bg-white">
                <Image
                  src={item.img}
                  alt={item.name}
                  width={600}
                  height={600}
                  class="aspect-square w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
                />
                <span class="absolute left-3 top-3 bg-navy-deep px-2.5 py-1 font-stencil text-[0.6rem] uppercase tracking-[0.16em] text-bone">
                  {item.type}
                </span>
              </div>
              <figcaption class="flex flex-1 flex-col p-5">
                <p class="font-display text-lg leading-snug">{item.name}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 font-semibold text-red">
                  Shop on Spiritsale
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  />
                </span>
              </figcaption>
            </a>
          </Reveal>
        ))
      }
    </div>

    <Reveal
      class="mt-14 flex flex-col items-center gap-4 border border-line bg-bone-deep px-6 py-12 text-center"
    >
      <Icon name="lucide:store" class="size-8 text-red" aria-hidden="true" />
      <h2 class="font-display text-2xl">See the full store.</h2>
      <p class="max-w-md leading-relaxed text-ink-soft">
        Sizes, colors, and more designs are available on our Spiritsale store.
        Every order helps fund mental-health care, PTSD service dogs, and
        outreach for our veterans.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <Button href={storeUrl} external>Visit the store</Button>
        <Button href="/donate" variant="secondary">Make a donation</Button>
      </div>
    </Reveal>
  </Section>

  <CallToAction />
</Base>
