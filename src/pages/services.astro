---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import TreatedImage from '@/components/TreatedImage.astro';
import Button from '@/components/Button.astro';
import CallToAction from '@/components/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

import americanFlag from '@/assets/photos/american-flag.jpg';
import serviceDogs from '@/assets/photos/service-dogs.png';
import withFamily from '@/assets/photos/with-family.png';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  services.map(async (s) => ({ entry: s, Content: (await render(s)).Content })),
);

const img: Record<string, ImageMetadata> = {
  'mental-health-aid': americanFlag,
  'ptsd-service-dogs': serviceDogs,
  'veterans-corner': withFamily,
};
const alt: Record<string, string> = {
  'mental-health-aid': 'An American flag flying on a flagpole at sunset',
  'ptsd-service-dogs': 'A veteran beside his service dog',
  'veterans-corner': 'A veteran walking with his children',
};
---

<Base
  title="Services"
  description="Veteran mental-health aid, PTSD service dogs, and the Veterans Corner — the programs through which the TriState Veterans Memorial Fund supports those who served."
>
  <PageHeader
    eyebrow="Our Services"
    title="A commitment to our communities."
    intro="Veterans face challenges no one else can fully see. These are the programs through which we meet them — with practical help, loyal companionship, and a community that listens."
  />

  {
    rendered.map(({ entry, Content }, i) => {
      const tone = i % 2 === 1 ? 'bone-deep' : 'bone';
      const flip = i % 2 === 1;
      const isCorner = entry.id === 'veterans-corner';
      return (
        <Section tone={tone} class="border-b border-line py-20 sm:py-24">
          <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <Reveal
              class:list={[
                'relative aspect-[4/3] lg:aspect-auto',
                flip && 'lg:order-2',
              ]}
            >
              <TreatedImage
                src={img[entry.id]}
                alt={alt[entry.id] ?? entry.data.title}
                fill
              />
            </Reveal>
            <Reveal delay={100} class="lg:self-center">
              <span class="inline-flex size-12 items-center justify-center rounded-full border border-line text-red">
                <Icon name={`lucide:${entry.data.icon}`} class="size-6" aria-hidden="true" />
              </span>
              <h2 class="mt-5 font-display text-3xl sm:text-4xl">
                {entry.data.title}
              </h2>
              <div class="rich mt-5 text-ink-soft">
                <Content />
              </div>
              <div class="mt-7 flex flex-wrap gap-3">
                {isCorner ? (
                  <>
                    <Button href="/veterans-corner">Visit the Veterans Corner</Button>
                    <Button href={site.social.facebook} external variant="secondary">
                      <Icon name="lucide:facebook" class="size-4" aria-hidden="true" />
                      Our Facebook
                    </Button>
                  </>
                ) : (
                  <>
                    <Button href={site.phoneHref}>
                      <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
                      Call now &middot; {site.phone}
                    </Button>
                    <Button href="/contact" variant="secondary">
                      Send a message
                    </Button>
                  </>
                )}
              </div>
            </Reveal>
          </div>
        </Section>
      );
    })
  }

  <CallToAction
    heading="Need help, or know someone who does?"
    body="Reach out today. One of our members will respond — and everything you share stays between us."
  />
</Base>
