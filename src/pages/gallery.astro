---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import CallToAction from '@/components/CallToAction.astro';

// Auto-load every photo in src/assets/gallery — drop a new .avif/.jpg/.png
// in that folder and it appears here on the next build, no edits needed.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{avif,jpg,jpeg,png,webp}',
  { eager: true },
);
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<Base
  title="Gallery"
  description="Photos from the TriState Veterans Memorial Fund — our events, ceremonies, and the community we are proud to stand beside."
>
  <PageHeader
    eyebrow="Gallery"
    title="Moments from the mission."
    intro="The events, the ceremonies, and the community behind our work — captured along the way."
  />

  <Section class="py-20 sm:py-24">
    <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
      {
        photos.map((photo, i) => (
          <Reveal class="mb-5 break-inside-avoid" delay={(i % 3) * 70}>
            <Image
              src={photo}
              alt="TriState Veterans Memorial Fund photo"
              widths={[480, 768, 1100]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="treated develop w-full border border-line"
            />
          </Reveal>
        ))
      }
    </div>
  </Section>

  <CallToAction
    heading="Be part of the next chapter."
    body="Join us at an event, or support the work — and help us carry this mission forward."
  />
</Base>
