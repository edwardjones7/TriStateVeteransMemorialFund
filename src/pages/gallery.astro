---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import CallToAction from '@/components/CallToAction.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import RaceBib from '@/components/RaceBib.astro';
import TicketStub from '@/components/TicketStub.astro';
import FlagCase from '@/components/FlagCase.astro';
import TimelineStop from '@/components/TimelineStop.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import PhotoAlbum, { type LoadedChapter } from '@/components/PhotoAlbum.astro';
import { album5k2026, type AlbumChapter } from '@/lib/album5k2026';
import { albumDance2026 } from '@/lib/albumDance2026';

// Auto-load every photo in src/assets/gallery — drop a new .avif/.jpg/.png
// in that folder and it appears here on the next build, no edits needed.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{avif,jpg,jpeg,png,webp}',
  { eager: true },
);
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

/* Event albums — each folder is ordered "NN-slug.avif", so strip the
 * numeric prefix to key each file by slug and let the album file supply
 * captions and chapter breaks. Mismatches fail the build rather than
 * dropping a photo quietly. */
const albumModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*/*.{avif,jpg,jpeg,png,webp}',
  { eager: true },
);
function loadAlbum(album: { id: string; chapters: AlbumChapter[] }): LoadedChapter[] {
  const bySlug = new Map(
    Object.entries(albumModules)
      .filter(([file]) => file.includes(`/gallery/${album.id}/`))
      .map(([file, mod]) => [
        file.replace(/^.*\/\d+-/, '').replace(/\.[^.]+$/, ''),
        mod.default,
      ]),
  );
  const chapters = album.chapters.map((chapter) => ({
    ...chapter,
    photos: chapter.photos.map(({ slug, caption }) => {
      const image = bySlug.get(slug);
      if (!image) throw new Error(`${album.id} album: no image file for slug "${slug}"`);
      bySlug.delete(slug);
      return { image, caption };
    }),
  }));
  if (bySlug.size) {
    throw new Error(
      `${album.id} album: image(s) not listed in its album file: ${[...bySlug.keys()].join(', ')}`,
    );
  }
  return chapters;
}
const danceChapters = loadAlbum(albumDance2026);
const raceChapters = loadAlbum({ id: '5k-2026', ...album5k2026 });

// Every clip is a YouTube embed — `id` is the code after youtu.be/.
// `album` pins a clip to the event on the timeline it belongs with; the
// rest collect under "More from the mission".
const videos = [
  { id: 'rTzuliRQMVY', title: 'Third Annual 5K', album: '5k-2026' },
  { id: 'aRGtQVFizLk', title: 'Veterans Day 2026', album: 'veterans-day-2026' },
  { id: 'h8X1aPzVC9Q', title: 'Featured on 6abc' },
  { id: 'RsOro6KpYko', title: 'Honoring Our Veterans' },
  { id: 'BD9h0t7h9RU', title: 'Second Annual 5K' },
  { id: 'xNgKeG1ekNU', title: 'First Annual 5K' },
];
const albumVideo = videos.find((v) => v.album === '5k-2026') ?? null;
const veteransDayVideo = videos.find((v) => v.album === 'veterans-day-2026') ?? null;
const otherVideos = videos.filter((v) => !v.album);
---

<Base
  title="Gallery"
  description="Photos from the TriState Veterans Memorial Fund: our events, ceremonies, and the community we are proud to stand beside."
>
  <PageHeader
    eyebrow="Gallery"
    title="Moments from the mission."
    intro="The events, the ceremonies, and the community behind our work, captured along the way."
  />

  {/* The page runs as a timeline, newest event first — each event opens
      with a dated TimelineStop. */}

  {/* ---------- Adelphia, the eve of Veterans Day 2026 ---------- */}
  <PhotoAlbum
    id="dance-2026"
    tone="night"
    date={albumDance2026.date}
    place={albumDance2026.venue}
    eyebrow={albumDance2026.title}
    heading={albumDance2026.heading}
    intro={albumDance2026.intro}
    chapters={danceChapters}
  >
    <TicketStub slot="emblem" {...albumDance2026.ticket} />
  </PhotoAlbum>

  {/* ---------- Veterans Day ceremony, Flags for Forgotten Veterans ---------- */}
  {
    veteransDayVideo && (
      <Section id="veterans-day-2026" tone="bone-deep" class="border-b border-line py-20 sm:py-24">
        <TimelineStop date="2026-11-07" place="Washington Lake Park · Sewell, NJ" />
        <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between md:gap-14">
          <Reveal class="max-w-2xl">
            <Eyebrow tone="ink">Veterans Day · Flags for Forgotten Veterans</Eyebrow>
            <h2 class="mt-4 font-display text-3xl sm:text-4xl">A flag for the forgotten.</h2>
            <p class="mt-3 text-ink-soft">
              At the Washington Lake Park amphitheater, a flag placed for each forgotten
              veteran. A day of remembrance, not celebration.
            </p>
          </Reveal>
          <Reveal class="group self-center md:shrink-0 md:self-start" delay={100}>
            <FlagCase title="Flags for Forgotten Veterans" detail="Nov 7 · 2026" />
          </Reveal>
        </div>
        <Reveal class="mt-12 max-w-4xl" delay={80}>
          <VideoEmbed id={veteransDayVideo.id} title={veteransDayVideo.title} showCaption={false} />
          <p class="mt-2.5 font-stencil text-xs uppercase tracking-[0.18em] text-ink-soft">
            Watch the ceremony
          </p>
        </Reveal>
      </Section>
    )
  }

  {/* ---------- 5K album, in the order the morning happened ---------- */}
  <PhotoAlbum
    id="5k-2026"
    date={album5k2026.date}
    place={album5k2026.venue}
    eyebrow={album5k2026.title}
    heading="Race morning, start to finish."
    intro={album5k2026.intro}
    chapters={raceChapters}
  >
    <RaceBib
      slot="emblem"
      date={album5k2026.date}
      eventName="TriState Veterans Memorial Fund"
      subtitle={album5k2026.title}
      venue={album5k2026.venue}
    />
    {
      albumVideo && (
        <Reveal class="mt-10 max-w-3xl" delay={80}>
          <VideoEmbed id={albumVideo.id} title={albumVideo.title} showCaption={false} />
          <p class="mt-2.5 font-stencil text-xs uppercase tracking-[0.18em] text-ink-soft">
            Watch the recap
          </p>
        </Reveal>
      )
    }
  </PhotoAlbum>

  <Section tone="bone-deep" class="py-20 sm:py-24">
    <Reveal class="max-w-2xl">
      <h2 class="font-display text-3xl sm:text-4xl">More from the mission</h2>
      <p class="mt-3 text-ink-soft">
        Ceremonies, fundraisers, and moments from across our events.
      </p>
    </Reveal>

    <Reveal class="mt-12 border-b border-line pb-3">
      <h3 class="font-display text-2xl sm:text-3xl">Watch</h3>
    </Reveal>
    <div class="mt-7 grid gap-6 sm:grid-cols-2">
      {
        otherVideos.map((video, i) => (
          <Reveal delay={(i % 2) * 80}>
            <VideoEmbed id={video.id} title={video.title} />
          </Reveal>
        ))
      }
    </div>

    <Reveal class="mt-14 border-b border-line pb-3">
      <h3 class="font-display text-2xl sm:text-3xl">Photos</h3>
    </Reveal>
    <div class="mt-7 columns-1 gap-5 sm:columns-2 lg:columns-3">
      {
        photos.map((photo, i) => (
          <Reveal class="mb-5 break-inside-avoid" delay={(i % 3) * 70}>
            <Image
              src={photo}
              alt="TriState Veterans Memorial Fund photo"
              widths={[480, 768, 1100]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="treated develop w-full border border-line"
            />
          </Reveal>
        ))
      }
    </div>
  </Section>

  <CallToAction
    heading="Be part of the next chapter."
    body="Join us at an event, or support the work, and help us carry this mission forward."
  />
</Base>
