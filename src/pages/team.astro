---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Reveal from '@/components/Reveal.astro';
import TeamCard from '@/components/TeamCard.astro';
import CallToAction from '@/components/CallToAction.astro';

const team = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  team.map(async (m) => ({ entry: m, Content: (await render(m)).Content })),
);
const leadership = rendered.filter((m) => m.entry.data.group === 'leadership');
const advisory = rendered.filter((m) => m.entry.data.group === 'advisory');

const groups = [
  {
    eyebrow: 'Leadership',
    title: 'The board of directors.',
    members: leadership,
    tone: 'bone' as const,
  },
  {
    eyebrow: 'Advisory Board',
    title: 'Counsel and community.',
    members: advisory,
    tone: 'bone-deep' as const,
  },
];
---

<Base
  title="Meet the Team"
  description="The board of directors and advisory board of the TriState Veterans Memorial Fund — neighbors, veterans, and community leaders committed to those who served."
>
  <PageHeader
    eyebrow="Meet the Team"
    title="Neighbors who chose to act."
    intro="A board of directors from diverse backgrounds — veterans and civilians alike — united by one belief: that those who served deserve our help finding their way home."
  />

  {
    groups.map((group) => (
      <Section
        tone={group.tone}
        class="border-b border-line py-20 sm:py-24"
      >
        <Reveal class="mb-12">
          <Eyebrow>{group.eyebrow}</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">{group.title}</h2>
        </Reveal>
        {/* Two independently-flowing columns: odd ranks left, even ranks
            right, so the pairing reads in rank order without a shared row
            height forcing a gap under the shorter bio. Below `lg` the
            columns collapse (`contents`) and `order` restores 1..n flow. */}
        <div class="flex flex-col gap-14 lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-12">
          {[0, 1].map((col) => (
            <div class="contents lg:flex lg:flex-col lg:gap-14">
              {group.members.map(({ entry, Content }, i) =>
                i % 2 === col ? (
                  <Reveal delay={col * 80} style={`order:${i + 1}`}>
                    <TeamCard
                      name={entry.data.name}
                      role={entry.data.role}
                      isVeteran={entry.data.isVeteran}
                      branch={entry.data.branch}
                      portrait={entry.data.portrait}
                    >
                      <Content />
                    </TeamCard>
                  </Reveal>
                ) : null,
              )}
            </div>
          ))}
        </div>
      </Section>
    ))
  }

  <CallToAction
    heading="Stand alongside this team."
    body="Our board gives its time freely. Your gift gives them the means to help a veteran today."
  />
</Base>
