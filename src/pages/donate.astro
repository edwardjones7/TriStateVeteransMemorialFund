---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Reveal from '@/components/Reveal.astro';
import Button from '@/components/Button.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

const impact = [
  {
    icon: 'brain',
    text: 'Connects veterans to counseling, therapy, and peer support.',
  },
  {
    icon: 'dog',
    text: 'Helps place trained service and emotional-support dogs.',
  },
  {
    icon: 'life-buoy',
    text: 'Puts crisis hotlines and resources into the right hands.',
  },
  {
    icon: 'flag',
    text: 'Funds the ceremonies and outreach that honor those who served.',
  },
];
---

<Base
  title="Donate"
  description="Support U.S. military veterans across the tri-state area. Every gift to the TriState Veterans Memorial Fund is tax-deductible."
>
  <PageHeader
    eyebrow="Donate"
    title="Give a veteran the help they earned."
    intro="The TriState Veterans Memorial Fund is a registered 501(c)(3) nonprofit. Every dollar you give stays close to home — and goes to work for veterans across our community."
  />

  <Section class="py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Why give */}
      <Reveal class="lg:col-span-5">
        <Eyebrow>Your gift at work</Eyebrow>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl">
          Small gifts. Real lives.
        </h2>
        <p class="mt-5 leading-relaxed text-ink-soft">
          We raise funds locally so we can act locally. Here is what your
          generosity makes possible:
        </p>
        <ul class="mt-7 space-y-4">
          {
            impact.map((item) => (
              <li class="flex items-start gap-3.5">
                <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-red/8 text-red">
                  <Icon name={`lucide:${item.icon}`} class="size-4.5" aria-hidden="true" />
                </span>
                <span class="leading-relaxed">{item.text}</span>
              </li>
            ))
          }
        </ul>
        <QuoteCard class="mt-9">
          <p class="font-display text-xl leading-tight">
            “Please consider supporting us. If you are able, every gift helps
            a veteran on the road back.”
          </p>
        </QuoteCard>
      </Reveal>

      {/* Ways to give */}
      <div class="lg:col-span-7">
        <Reveal>
          <Eyebrow>Ways to give</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">
            Choose what works for you.
          </h2>
        </Reveal>

        <div class="mt-8 space-y-5">
          {/* Online */}
          <Reveal delay={60}>
            <div class="border border-line bg-bone p-7 sm:p-8">
              <div class="flex items-center gap-3">
                <Icon name="lucide:credit-card" class="size-5 text-red" aria-hidden="true" />
                <h3 class="font-display text-2xl">Give online</h3>
              </div>
              <p class="mt-2.5 leading-relaxed text-ink-soft">
                Make a secure one-time or recurring gift through PayPal — no
                account required. The fastest way to help today.
              </p>
              <Button href={site.donateUrl} external size="lg" class="mt-5">
                Donate with PayPal
                <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
              </Button>
            </div>
          </Reveal>

          {/* By mail */}
          <Reveal delay={120}>
            <div class="border border-line bg-bone p-7 sm:p-8">
              <div class="flex items-center gap-3">
                <Icon name="lucide:mail" class="size-5 text-red" aria-hidden="true" />
                <h3 class="font-display text-2xl">Give by mail</h3>
              </div>
              <p class="mt-2.5 leading-relaxed text-ink-soft">
                Prefer to send a check? Make it payable to
                <strong class="font-semibold text-ink">
                  {' '}TriState Veterans Memorial Fund
                </strong>{' '}
                and mail it to:
              </p>
              <p class="mt-3 border-l-2 border-red bg-bone-deep py-3 pl-4 font-stencil text-sm">
                {site.mailing}
              </p>
            </div>
          </Reveal>

          {/* Sponsor */}
          <Reveal delay={180}>
            <div class="border border-line bg-bone p-7 sm:p-8">
              <div class="flex items-center gap-3">
                <Icon name="lucide:handshake" class="size-5 text-red" aria-hidden="true" />
                <h3 class="font-display text-2xl">Sponsor or host</h3>
              </div>
              <p class="mt-2.5 leading-relaxed text-ink-soft">
                Businesses and organizations can sponsor an event or host a
                fundraiser. Let's find the right fit for you.
              </p>
              <Button href="/contact" variant="secondary" class="mt-5">
                Talk with us
              </Button>
            </div>
          </Reveal>
        </div>

        <Reveal delay={220}>
          <p
            class="mt-7 flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft"
          >
            <Icon name="lucide:badge-check" class="mt-0.5 size-4 shrink-0 text-navy" aria-hidden="true" />
            {site.name} is a registered 501(c)(3) nonprofit. Your donation is
            tax-deductible to the extent allowed by law.
          </p>
        </Reveal>
      </div>
    </div>
  </Section>
</Base>
