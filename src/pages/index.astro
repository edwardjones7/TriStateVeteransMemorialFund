---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import SectionRule from '@/components/SectionRule.astro';
import Reveal from '@/components/Reveal.astro';
import TreatedImage from '@/components/TreatedImage.astro';
import FeaturedEvents from '@/components/FeaturedEvents.astro';
import StatBand from '@/components/StatBand.astro';
import SponsorGrid from '@/components/SponsorGrid.astro';
import CallToAction from '@/components/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';
import { isUpcoming } from '@/lib/format';
import { eventLink } from '@/lib/eventSchema';
import { dateParts } from '@/lib/format';

import heroImg from '@/assets/photos/uniform.png';
import missionImg from '@/assets/photos/salute.jpg';
import serviceDogs from '@/assets/photos/service-dogs.png';
import cornerEmbrace from '@/assets/photos/veteran-family-embrace.jpg';
import backHeadshot from '@/assets/photos/backheadshot.png';
import abcLogo from '@/assets/press/6abc-logo.png';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const sponsors = await getCollection('sponsors');

const events = await getCollection('events');
const upcoming = events
  .filter((e) => isUpcoming(e.data.date))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
// Headline events: every featured upcoming event, else the soonest one.
const featured = upcoming.filter((e) => e.data.featured);
const headliners = featured.length ? featured : upcoming.slice(0, 1);
const featuredEvent = headliners[0] ?? null;
// Hero CTA: with several headliners, scroll to them; with one, go straight to
// its sign-up site (or its own page). Null when nothing is upcoming.
const heroCta =
  headliners.length > 1
    ? { href: '#upcoming', label: 'See upcoming events', external: false, track: undefined }
    : featuredEvent
      ? eventLink(featuredEvent)
      : null;
const heroCtaLabel =
  headliners.length === 1 &&
  featuredEvent?.data.registrationUrl &&
  /5k/i.test(featuredEvent.data.title)
    ? 'Register for the 5K'
    : (heroCta?.label ?? '');
// Date chips under the hero buttons, one per headliner.
const heroChips =
  headliners.length > 1
    ? headliners.slice(0, 2).map((e) => {
        const p = dateParts(e.data.date);
        return {
          date: `${p.month} ${p.day}`,
          title: e.data.shortTitle ?? e.data.title,
        };
      })
    : [];

const serviceImg: Record<string, ImageMetadata> = {
  'mental-health-aid': backHeadshot,
  'ptsd-service-dogs': serviceDogs,
  'veterans-corner': cornerEmbrace,
};
const serviceAlt: Record<string, string> = {
  'mental-health-aid': 'A service member salutes during a ceremony',
  'ptsd-service-dogs': 'A veteran with his service dog',
  'veterans-corner': 'A soldier embraces their spouse and child',
};

const mapSrc =
  'https://www.google.com/maps?q=321+Theis+Rd,+Sewell,+NJ+08080&output=embed';

const involve = [
  {
    icon: 'hand-heart',
    title: 'Donate',
    body: 'Every gift funds mental-health aid, service dogs, and outreach. Give once or monthly.',
    href: '/donate',
    cta: 'Give now',
  },
  {
    icon: 'users',
    title: 'Volunteer',
    body: 'Lend your hands at a 5K, a ceremony, or a fundraiser. There is a place for everyone.',
    href: '/contact',
    cta: 'Get involved',
  },
  {
    icon: 'handshake',
    title: 'Sponsor',
    body: 'Local businesses keep this mission moving. Partner with us and stand with our veterans.',
    href: '/contact',
    cta: 'Become a sponsor',
  },
];
---

<Base
  title="Honoring & Supporting Our Veterans"
  description="A Sewell, NJ 501(c)(3) honoring U.S. military veterans across the tri-state area: mental-health aid, PTSD service dogs, and our annual 5K run/walk. Register or donate today."
>
  {/* ---------- Hero ---------- */}
  <section
    class="relative isolate flex min-h-[88vh] flex-col items-center justify-center overflow-hidden bg-navy-deep"
  >
    <Image
      src={heroImg}
      alt="A United States soldier in uniform, the flag patch on the shoulder"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    {/* legibility overlays */}
    <div class="absolute inset-0 -z-10 bg-navy-deep/55"></div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-deep via-navy-deep/40 to-navy-deep/70"
    >
    </div>

    <div
      class="mx-auto w-full max-w-4xl px-6 py-32 text-center sm:px-8 lg:py-40"
    >
      <Reveal>
        <Eyebrow tone="bone" class="justify-center">
          Est. {site.founded} &middot; Sewell, New Jersey
        </Eyebrow>
      </Reveal>
      <Reveal delay={80}>
        <h1
          class="mx-auto mt-6 max-w-[18ch] font-display text-[3.25rem] leading-[0.9] text-bone sm:text-[5.5rem] lg:text-[7rem]"
        >
          Bringing our veterans <span class="text-red-light"
            >all the way home.</span
          >
        </h1>
      </Reveal>
      <Reveal delay={150}>
        <p
          class="mx-auto mt-7 max-w-xl text-lg leading-relaxed text-bone/85"
        >
          Honoring and supporting U.S. military veterans across South Jersey,
          Southeastern Pennsylvania, and Northern Delaware through
          mental-health aid, PTSD service dogs, and a community that refuses
          to look away.
        </p>
      </Reveal>
      <Reveal delay={210}>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          {heroCta && (
            <Button
              href={heroCta.href}
              size="lg"
              external={heroCta.external}
              data-track={heroCta.track}
            >
              {heroCtaLabel}
            </Button>
          )}
          <Button
            href="/donate"
            variant={heroCta ? 'light' : 'primary'}
            size="lg">Donate</Button
          >
          <Button href="/mission" variant="on-dark" size="lg"
            >Our mission</Button
          >
        </div>
      </Reveal>
      {
        heroChips.length > 0 && (
          <Reveal delay={270}>
            <a
              href="#upcoming"
              class="group mt-8 inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-2 rounded-full border border-bone/20 bg-navy-deep/60 px-5 py-2.5 backdrop-blur transition-colors duration-200 hover:border-gold/60"
            >
              {heroChips.map((c, i) => (
                <>
                  {i > 0 && (
                    <span class="size-1.5 rotate-45 bg-red-light" aria-hidden="true" />
                  )}
                  <span class="flex items-baseline gap-2">
                    <span class="font-stencil text-xs tracking-[0.18em] text-gold">
                      {c.date}
                    </span>
                    <span class="text-sm font-semibold text-bone">{c.title}</span>
                  </span>
                </>
              ))}
              <Icon
                name="lucide:arrow-down"
                class="size-4 text-bone/70 transition-transform duration-200 group-hover:translate-y-0.5"
                aria-hidden="true"
              />
            </a>
          </Reveal>
        )
      }
    </div>

    <div
      class="absolute inset-x-0 bottom-0 border-t border-bone/15 bg-navy-deep/70"
    >
      <p
        class="mx-auto max-w-7xl px-6 py-3.5 text-center font-stencil text-xs uppercase tracking-[0.18em] text-bone/65 sm:px-8 lg:px-12"
      >
        Serving South Jersey &middot; Southeastern Pennsylvania &middot;
        Northern Delaware
      </p>
    </div>
  </section>

  {/* ---------- Mission excerpt ---------- */}
  <Section tone="bone-deep" class="border-b border-line py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <Reveal class="lg:col-span-5">
        <TreatedImage
          src={missionImg}
          alt="A service member salutes the American flag flying at half-mast during a memorial ceremony"
          ratio="3 / 4"
          imgClass="object-[center_30%]"
        />
      </Reveal>
      <div class="lg:col-span-7">
        <Reveal>
          <Eyebrow>Why we are here</Eyebrow>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl">
            Some of us have seen the cost of war up close.
          </h2>
          <p class="mt-5 max-w-lg leading-relaxed text-ink-soft">
            We are a board of neighbors, veterans among us, who watched too many heroes struggle to find help after coming home. So we built a place to change that.
          </p>
        </Reveal>
        <Reveal delay={110}>
          <QuoteCard class="mt-7">
            <p class="font-display text-xl leading-tight text-ink">
              “We formed this organization because too many veterans are lost
              to suicide, and it is unacceptable to us that the men and women
              we call heroes cannot get the help they need. Our mission is to
              change that.”
            </p>
            <figcaption
              class="mt-5 font-stencil text-xs uppercase tracking-[0.16em] text-ink-soft"
            >
              The Board of Directors
            </figcaption>
          </QuoteCard>
        </Reveal>
        <Reveal delay={160}>
          <Button href="/mission" variant="ghost" class="mt-6">
            Read our full mission
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </Button>
        </Reveal>
      </div>
    </div>
  </Section>

  {/* ---------- What we do ---------- */}
  <Section class="py-20 sm:py-24">
    <Reveal class="max-w-2xl">
      <Eyebrow>How we help</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">
        Three ways we stand with veterans.
      </h2>
    </Reveal>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        services.map((s, i) => (
          <Reveal delay={i * 70}>
            <a
              href="/services"
              class="group flex h-full flex-col overflow-hidden border border-line bg-bone transition-[transform,border-color] duration-200 ease-out-soft hover:-translate-y-1 hover:border-red/45"
            >
              <TreatedImage
                src={serviceImg[s.id]}
                alt={serviceAlt[s.id] ?? s.data.title}
                ratio="4 / 3"
              />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-2xl">{s.data.title}</h3>
                <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">
                  {s.data.summary}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 font-stencil text-xs font-bold uppercase tracking-[0.1em] text-red">
                  Learn more
                  <Icon
                    name="lucide:arrow-right"
                    class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </span>
              </div>
            </a>
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* ---------- Headline events ---------- */}
  {headliners.length > 0 && <FeaturedEvents events={headliners} id="upcoming" />}

  {/* ---------- Sponsors ---------- */}
  <Section class="border-y border-line py-20 sm:py-24">
    <Reveal class="mx-auto max-w-2xl text-center">
      <Eyebrow class="justify-center">Our sponsors</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">
        A community of dedicated professionals.
      </h2>
      <p class="mt-4 text-ink-soft">
        These local businesses and trade organizations keep our mission
        moving. We are grateful for every one of them.
      </p>
      <SectionRule class="mx-auto mt-8 max-w-xs" />
    </Reveal>
    <Reveal class="mt-12" delay={80}>
      <SponsorGrid sponsors={sponsors} />
    </Reveal>
    <Reveal class="mt-10 flex flex-wrap justify-center gap-4" delay={120}>
      <Button href="/contact" variant="secondary">Become a sponsor</Button>
      <Button href="/sponsors" variant="ghost">
        All sponsors
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </Button>
    </Reveal>
  </Section>

  {/* ---------- Impact statistic ---------- */}
  <StatBand
    eyebrow="Why we exist"
    figure="22"
    lede="Twenty-two veterans a day. That figure is why our founders refused to stay silent, and why this Fund exists."
    source="Honor their service · End the silence"
  />

  {/* ---------- Press / As featured on ---------- */}
  <section class="border-t border-line bg-bone">
    <Reveal
      class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-4 px-6 py-8 sm:flex-row sm:gap-6 sm:px-8 lg:px-12"
    >
      <p
        class="font-stencil text-xs font-bold uppercase tracking-[0.18em] text-ink-soft"
      >
        As featured on
      </p>
      <Image
        src={abcLogo}
        alt="6abc Action News"
        widths={[120, 240]}
        sizes="120px"
        class="h-14 w-auto"
      />

      <p class="text-sm text-ink-soft sm:border-l sm:border-line sm:pl-6">
        Our work honoring local veterans was spotlighted on Philadelphia&rsquo;s
        6abc Action News.
      </p>
    </Reveal>
  </section>

  {/* ---------- Get involved ---------- */}
  <Section tone="bone-deep" class="border-t border-line py-20 sm:py-24">
    <Reveal class="max-w-2xl">
      <Eyebrow>Get involved</Eyebrow>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl">
        There is a place for you in this.
      </h2>
    </Reveal>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        involve.map((item, i) => (
          <Reveal delay={i * 60}>
            <div class="flex h-full flex-col border border-line bg-bone p-7">
              <span class="inline-flex size-12 items-center justify-center rounded-full bg-red/8 text-red">
                <Icon
                  name={`lucide:${item.icon}`}
                  class="size-6"
                  aria-hidden="true"
                />
              </span>
              <h3 class="mt-5 font-display text-2xl">{item.title}</h3>
              <p class="mt-2.5 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">
                {item.body}
              </p>
              <Button href={item.href} variant="ghost" class="mt-5">
                {item.cta}
                <Icon
                  name="lucide:arrow-right"
                  class="size-4"
                  aria-hidden="true"
                />
              </Button>
            </div>
          </Reveal>
        ))
      }
    </div>
    <Reveal
      class="mt-12 flex flex-col gap-3 border border-line bg-bone px-6 py-5 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="flex items-center gap-2.5 text-ink-soft">
        <Icon
          name="lucide:map-pin"
          class="size-4 text-red"
          aria-hidden="true"
        />
        Find us at {site.address.full}
      </p>
      <Button href="/contact" variant="ghost">
        Directions &amp; contact
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </Button>
    </Reveal>
    <Reveal class="mt-6 overflow-hidden border border-line" delay={80}>
      <iframe
        src={mapSrc}
        title={`Map to ${site.address.full}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-[16/9] w-full"></iframe>
    </Reveal>
  </Section>

  <CallToAction />
</Base>
