---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Emblem from '@/components/Emblem.astro';
import Button from '@/components/Button.astro';
import SectionRule from '@/components/SectionRule.astro';
import { site } from '@/config/site';
---

<Base
  title="Thank You"
  description="Thank you for reaching out to the TriState Veterans Memorial Fund."
  noindex={true}
>
  <Section class="py-28 text-center sm:py-36">
    <div class="mx-auto max-w-xl">
      <Emblem class="mx-auto w-28 text-gold" />
      <h1 class="mt-8 font-display text-4xl sm:text-5xl">Message received.</h1>
      <p class="mt-5 leading-relaxed text-ink-soft">
        Thank you for reaching out. One of our members will get back to you
        shortly. If your matter is urgent, please call us directly at
        <a href={site.phoneHref} class="link-underline font-medium text-ink"
          >{site.phone}</a
        >.
      </p>
      <SectionRule class="mx-auto mt-9 max-w-xs" />
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/">Return home</Button>
        <Button href="/events" variant="secondary">See our events</Button>
      </div>
    </div>
  </Section>
</Base>
