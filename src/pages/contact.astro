---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Reveal from '@/components/Reveal.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

const navy =
  'w-full rounded-[3px] border border-line bg-bone px-4 py-3 text-ink placeholder:text-ink-soft/55 transition-colors focus-visible:border-red';
const label =
  'block font-stencil text-xs uppercase tracking-[0.14em] text-ink-soft';

const channels = [
  { icon: 'phone', label: 'Call us', value: site.phone, href: site.phoneHref },
  {
    icon: 'mail',
    label: 'Email us',
    value: site.email,
    href: `mailto:${site.email}`,
  },
  {
    icon: 'facebook',
    label: 'Facebook',
    value: 'Follow our page',
    href: site.social.facebook,
    external: true,
  },
  { icon: 'radio', label: 'On the air', value: `Hear us on ${site.radio}` },
];
const mapSrc =
  'https://www.google.com/maps?q=321+Theis+Rd,+Sewell,+NJ+08080&output=embed';

// Web3Forms access key — registered to tristatevmf@gmail.com. This is a PUBLIC
// (non-secret) key inlined into the client bundle, so it's safe as a default.
// PUBLIC_WEB3FORMS_KEY (Vercel project / .env) overrides it when set.
const web3formsKey =
  import.meta.env.PUBLIC_WEB3FORMS_KEY || '85742a81-c592-404b-89e6-63fcf1593f32';
// No-JS fallback: Web3Forms redirects here after a successful POST.
const redirectUrl = `${site.url}/thank-you/`;
---

<Base
  title="Contact"
  description="Get in touch with the TriState Veterans Memorial Fund. We are here to help veterans and their families however we can."
>
  <PageHeader
    eyebrow="Contact"
    title="Your voice matters. We're listening."
    intro="Whether you need help, want to volunteer, or simply have a question — send us a message and one of our members will reach out."
  />

  <Section class="py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Form */}
      <Reveal class="lg:col-span-7">
        <Eyebrow>Send us a message</Eyebrow>
        <h2 class="mt-4 font-display text-3xl">We'll get back to you shortly.</h2>

        {web3formsKey ? (
        <form
          id="contact-form"
          method="POST"
          action="https://api.web3forms.com/submit"
          data-phone={site.phone}
          class="mt-8 space-y-5"
        >
          {/* Web3Forms config (https://web3forms.com) */}
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="New message from the TriState VMF website" />
          <input type="hidden" name="from_name" value={site.name} />
          {/* No-JS fallback: redirect to the thank-you page after submit. */}
          <input type="hidden" name="redirect" value={redirectUrl} />
          {/* Honeypot — bots fill this, humans never see it. */}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="first-name" class={label}>First name</label>
              <input
                id="first-name"
                name="first-name"
                type="text"
                required
                autocomplete="given-name"
                class={`mt-2 ${navy}`}
              />
            </div>
            <div>
              <label for="last-name" class={label}>Last name</label>
              <input
                id="last-name"
                name="last-name"
                type="text"
                required
                autocomplete="family-name"
                class={`mt-2 ${navy}`}
              />
            </div>
          </div>

          <div>
            <label for="email" class={label}>Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class={`mt-2 ${navy}`}
            />
          </div>

          <div>
            <label for="phone" class={label}>Phone <span class="normal-case tracking-normal">(optional)</span></label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              class={`mt-2 ${navy}`}
            />
          </div>

          <div>
            <label for="message" class={label}>Your message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class={`mt-2 ${navy} resize-y`}></textarea>
          </div>

          <button
            type="submit"
            data-submit
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[3px] bg-red px-7 py-3 font-body font-semibold text-bone shadow-sm transition-[background-color,transform] duration-150 ease-out-soft hover:bg-red-deep active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span data-submit-label>Send message</span>
            <Icon name="lucide:send" class="size-4" aria-hidden="true" />
          </button>

          {/* Submission status — announced to screen readers via the JS handler. */}
          <p data-form-status role="status" aria-live="polite" class="hidden text-sm font-medium"></p>
        </form>
        ) : (
          <div class="mt-8 border border-line bg-bone-deep p-6 text-sm leading-relaxed text-ink-soft">
            <p class="font-semibold text-ink">The contact form is being configured.</p>
            <p class="mt-2">
              In the meantime, please reach us directly by phone at
              <a href={site.phoneHref} class="link-underline font-medium text-red">{site.phone}</a>
              or email
              <a href={`mailto:${site.email}`} class="link-underline font-medium text-red">{site.email}</a>.
            </p>
          </div>
        )}
      </Reveal>

      {/* Details */}
      <Reveal class="lg:col-span-5" delay={100}>
        <div class="border border-line bg-bone-deep p-7 sm:p-8">
          <Eyebrow>Reach us directly</Eyebrow>
          <ul class="mt-6 space-y-5">
            {
              channels.map((c) => (
                <li class="flex items-start gap-3.5">
                  <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-bone text-red">
                    <Icon name={`lucide:${c.icon}`} class="size-4.5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block font-stencil text-xs uppercase tracking-[0.14em] text-ink-soft">
                      {c.label}
                    </span>
                    {c.href ? (
                      <a
                        href={c.href}
                        target={c.external ? '_blank' : undefined}
                        rel={c.external ? 'noopener noreferrer' : undefined}
                        class="link-underline font-medium text-ink"
                      >
                        {c.value}
                      </a>
                    ) : (
                      <span class="font-medium text-ink">{c.value}</span>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>

          <hr class="my-7 border-line" />

          <Eyebrow>Visit us</Eyebrow>
          <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed text-ink">
            <p class="font-medium">{site.address.full}</p>
            <p class="text-ink-soft">{site.address.note}</p>
            <p class="text-ink-soft">Mailing: {site.mailing}</p>
            <p class="text-ink-soft">Hours: {site.hours}</p>
          </address>
        </div>

        <div class="mt-6 overflow-hidden border border-line">
          <iframe
            src={mapSrc}
            title="Map to 321 Theis Rd., Sewell, NJ"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="aspect-[4/3] w-full"></iframe>
        </div>
      </Reveal>
    </div>
  </Section>

  <script>
    // Progressive enhancement: submit the contact form via fetch for inline
    // success/error feedback. Without JS, the form posts directly to Web3Forms
    // and falls back to the `redirect` hidden field (/thank-you/).
    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!form || form.dataset.enhanced === 'true') return;
      form.dataset.enhanced = 'true';

      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('[data-submit]');
      const label = form.querySelector<HTMLElement>('[data-submit-label]');

      const setStatus = (message: string, ok: boolean) => {
        if (!status) return;
        status.textContent = message;
        status.classList.remove('hidden');
        status.style.color = ok ? 'var(--color-ink)' : 'var(--color-red)';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        if (button) button.disabled = true;
        if (label) label.textContent = 'Sending…';
        setStatus('', true);
        status?.classList.add('hidden');

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            form.reset();
            setStatus("Thank you — your message is on its way. We'll be in touch shortly.", true);
            // GA4 conversion (no-op if analytics is disabled).
            window.gtag?.('event', 'contact_submit', { method: 'contact_form' });
          } else {
            setStatus(
              "Sorry — something went wrong. Please try again, or call us at " +
                (form.dataset.phone || 'our number') + '.',
              false,
            );
          }
        } catch {
          setStatus('Network error — please check your connection and try again.', false);
        } finally {
          if (button) button.disabled = false;
          if (label) label.textContent = 'Send message';
        }
      });
    }

    initContactForm();
    // Re-bind after client-side (View Transitions) navigation.
    document.addEventListener('astro:page-load', initContactForm);
  </script>
</Base>
