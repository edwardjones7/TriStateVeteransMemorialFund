---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '@/components/SEO.astro';
import Analytics from '@/components/Analytics.astro';
import EventBanner from '@/components/EventBanner.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieNotice from '@/components/CookieNotice.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbLabel?: string;
}
const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  ogType,
  noindex,
  jsonLd,
  breadcrumbLabel,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
      breadcrumbLabel={breadcrumbLabel}
    />
    <Analytics />
    <ClientRouter />
    {/* Set has-js before first paint so reveal elements never flash. */}
    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[100] focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:rounded-[3px] focus:bg-red focus:px-4 focus:py-2 focus:font-semibold focus:text-bone"
      >Skip to content</a
    >
    <EventBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
    <script>
      import '@/scripts/motion.ts';
      import '@/scripts/track.ts';
    </script>
  </body>
</html>
